#!/bin/bash
#==============================================================================
# Template: Conda-based Bioinformatics Pipeline Step
# Usage: Copy and customize for each pipeline step
# Generated by: OpenCode Bio — slurm-execution skill
#==============================================================================

#SBATCH --job-name=bio-pipeline
#SBATCH --partition=base
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=logs/slurm/%x_%j.log
#SBATCH --error=logs/slurm/%x_%j.err

# ============ Environment Setup ============
source /jinxianstor/apps/Anaconda3/conda.env

# Activate the project-specific conda environment
# conda activate qiime2-2024.5
# conda activate biobakery

# ============ Verification ============
echo "========================================="
echo "Job ID:       $SLURM_JOB_ID"
echo "Node:         $(hostname)"
echo "Start:        $(date)"
echo "Working dir:  $(pwd)"
echo "CPUs:         $SLURM_CPUS_PER_TASK"
echo "Memory (MB):  $SLURM_MEM_PER_NODE"
echo "Conda env:    $CONDA_DEFAULT_ENV"
echo "========================================="

# Verify tools
# which fastp && fastp --version
# which qiime && qiime --version

# ============ Main Task ============
# TODO: Replace with your actual pipeline commands
#
# Example: QC with fastp
# fastp \
#   -i data/raw/sample_R1.fastq.gz \
#   -I data/raw/sample_R2.fastq.gz \
#   -o data/qc/sample_clean_R1.fastq.gz \
#   -O data/qc/sample_clean_R2.fastq.gz \
#   --thread $SLURM_CPUS_PER_TASK \
#   --json results/qc/sample.fastp.json \
#   --html results/qc/sample.fastp.html

echo "Pipeline step completed."

# ============ Post-Task ============
EXIT_CODE=$?
echo "========================================="
echo "Exit code: $EXIT_CODE"
echo "End:       $(date)"
echo "========================================="

exit $EXIT_CODE
