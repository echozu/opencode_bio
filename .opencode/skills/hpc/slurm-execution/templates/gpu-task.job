#!/bin/bash
#==============================================================================
# Template: GPU Task (Deep Learning / AI Inference)
# Partition: gpu (NVIDIA L20 48GB × 8 per node)
# Generated by: OpenCode Bio — slurm-execution skill
#==============================================================================

#SBATCH --job-name=gpu-task
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=48:00:00
#SBATCH --output=logs/slurm/%x_%j.log
#SBATCH --error=logs/slurm/%x_%j.err

# ============ Environment Setup ============
source /jinxianstor/apps/Anaconda3/conda.env

# Activate the ML/DL environment
# conda activate pytorch
# conda activate tensorflow

# ============ Verification ============
echo "========================================="
echo "Job ID:       $SLURM_JOB_ID"
echo "Node:         $(hostname)"
echo "Start:        $(date)"
echo "CPUs:         $SLURM_CPUS_PER_TASK"
echo "Memory (MB):  $SLURM_MEM_PER_NODE"
echo "GPUs:         $SLURM_GPUS_ON_NODE"
echo "CUDA devices: $CUDA_VISIBLE_DEVICES"
echo "========================================="

# Verify GPU is accessible
nvidia-smi
python -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}, Devices: {torch.cuda.device_count()}')" 2>/dev/null

# ============ Main Task ============
# TODO: Replace with your GPU computation
#
# Example: Run a deep learning model
# python train.py \
#   --data data/processed/ \
#   --output results/model/ \
#   --epochs 100 \
#   --batch-size 32 \
#   --gpus 1

echo "GPU task completed."

# ============ Post-Task ============
EXIT_CODE=$?
echo "========================================="
echo "Exit code: $EXIT_CODE"
echo "End:       $(date)"
echo "========================================="

exit $EXIT_CODE
